# Publish the paper pipeline and examples; retain local research outside Git.
/*
!/.gitattributes
!/.gitignore
!/CITATION.cff
!/NOTICE.md
!/README.md
!/assets/
!/cwb_space/
!/data/
!/docs/
!/examples/
!/pipeline/
!/pyproject.toml
!/requirements-analysis.txt
!/requirements-figures.txt
!/requirements-pipeline.txt
!/tests/

/data/*
!/data/analysis/
!/data/checksums.json
!/data/pipeline/
!/data/published_figures.json
!/data/reconstruction/
!/data/response/
!/data/sangria/
!/data/strength/

/docs/*
!/docs/CODE_PROVENANCE.json
!/docs/RELEASE_REVIEW.md
!/docs/REPRODUCIBILITY.md

/examples/*
!/examples/plot_reconstruction.py
!/examples/plot_response.py
!/examples/plot_sangria.py
!/examples/plot_strength.py
!/examples/recover_candidates.py
!/examples/reproduce_all.py
!/examples/run_pipeline.py
!/examples/verify_data.py

# Generated outputs, environments and caches
outputs/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mplconfig/
.numba_cache/
*.egg-info/
build/
dist/
.DS_Store
.env
external_data/
